{
  "openapi": "3.0.0",
  "info": {
    "title": "Voice AI Tools API",
    "description": "Flask backend for voice synthesis, voice cloning, OSINT lookups, and PDF forensics",
    "version": "2.0.0",
    "contact": {
      "name": "Voice AI Tools"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5001",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Voice-Token",
        "description": "Shared secret token for authentication"
      },
      "signatureAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "HMAC-SHA256 signature for replay protection (when enabled)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "TTSSRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to synthesize to speech",
            "maxLength": 2000
          },
          "voice_id": {
            "type": "string",
            "description": "Voice ID or name (e.g., 'Kore', 'local_voice_123', 'wav_ref_456')"
          },
          "call_type": {
            "type": "string",
            "description": "Call type for voice routing (e.g., 'LEGITIMATE', 'SCAM')"
          },
          "explicit_voice_id": {
            "type": "string",
            "description": "Explicit voice override (if supported)"
          }
        }
      },
      "LogEntry": {
        "type": "object",
        "required": ["action", "text"],
        "properties": {
          "action": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "tts_engine": {
            "type": "boolean"
          },
          "api_key_configured": {
            "type": "boolean"
          },
          "auth_enabled": {
            "type": "boolean"
          },
          "uptime_seconds": {
            "type": "integer"
          },
          "memory_mb": {
            "type": "number"
          },
          "cpu_percent": {
            "type": "number"
          },
          "thread_count": {
            "type": "integer"
          },
          "disk_gb_free": {
            "type": "number"
          },
          "disk_gb_total": {
            "type": "number"
          },
          "voice_embeddings_count": {
            "type": "integer"
          },
          "voice_samples_count": {
            "type": "integer"
          },
          "coqui_model_available": {
            "type": "boolean"
          },
          "optional_deps": {
            "type": "object",
            "properties": {
              "shodan": {
                "type": "boolean"
              },
              "pdf_analysis": {
                "type": "boolean"
              },
              "osint_lookup": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns server status and configuration information",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tts": {
      "post": {
        "summary": "Synthesize speech from text",
        "description": "Converts text to speech using configured TTS engine",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TTSSRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audio data",
            "content": {
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "TTS synthesis failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/presets": {
      "get": {
        "summary": "Get voice presets",
        "description": "Retrieve saved voice presets",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "Voice presets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save voice presets",
        "description": "Save voice presets configuration",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presets saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/log": {
      "get": {
        "summary": "Get session log",
        "description": "Retrieve session activity log",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "Session log",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Append to session log",
        "description": "Add an entry to the session log",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogEntry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log entry added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/log/clear": {
      "post": {
        "summary": "Clear session log",
        "description": "Clear all session log entries",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "Log cleared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shodan": {
      "get": {
        "summary": "Shodan host lookup",
        "description": "Query Shodan for host information (requires SHODAN_API_KEY)",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "IP address to query"
          }
        ],
        "responses": {
          "200": {
            "description": "Shodan host data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Shodan API unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/analyze_pdf": {
      "post": {
        "summary": "Analyze PDF file",
        "description": "Extract metadata, links, IPs, and detect suspicious patterns from PDF",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PDF analysis results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file or analysis failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/train": {
      "post": {
        "summary": "Train voice model",
        "description": "Upload audio samples for voice training",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "samples": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Voice training initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "voice_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid training data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/model_status": {
      "get": {
        "summary": "Get voice model status",
        "description": "Check voice model training status",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "Model status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/lookup": {
      "post": {
        "summary": "OSINT lookup",
        "description": "Perform OSINT lookup for domain, IP, or phone number",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["domain", "ip", "phone"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OSINT lookup results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}