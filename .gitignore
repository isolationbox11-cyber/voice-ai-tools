# ===========================================================
# SECRETS & CREDENTIALS  — never commit these
# ===========================================================
.env
.env.*
*.env
.envrc

# Explicit secret/key file name patterns
*secret*
*secrets*
*credential*
*credentials*
*api_key*
*apikey*
*api-key*
*token*
*private_key*
*privatekey*
*access_key*

# Google / GCP service account JSON
*service_account*.json
*serviceaccount*.json
gcloud-key*.json

# Common config files that often contain keys
config.local.*
settings.local.*
local_settings.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

