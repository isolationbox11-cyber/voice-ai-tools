# ── Required ──────────────────────────────────────────────────────────
# Google Gemini API key (used for TTS synthesis)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Recommended in production ─────────────────────────────────────────
# Shared secret sent in X-Voice-Token header by the extension.
# If unset, server runs in open dev mode (all endpoints accessible).
VOICE_SERVER_TOKEN=your_secret_token_here

# ── Optional ──────────────────────────────────────────────────────────
# Shodan API key — enables the /shodan endpoint
SHODAN_API_KEY=your_shodan_api_key_here

# Extra CORS origins (comma-separated), e.g. your Chrome extension ID
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyz123456

# Server bind port (default: 5001)
# PORT=5001

# Set to "1" to allow binding to non-loopback addresses (unsafe — use with caution)
# ALLOW_NETWORK_BINDING=0

# Custom bind address — only honoured when ALLOW_NETWORK_BINDING=1
# HOST=127.0.0.1

# Set to "production" to enforce VOICE_SERVER_TOKEN requirement
# FLASK_ENV=production
